{
  "name": "spawncamp",
  "version": "1.0.0",
  "description": "A Cold Turkey-style app blocker: scheduled blocking with a timed typing challenge.",
  "author": "Connor",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "preview:web": "vite --config vite.preview.config.ts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "make-icon": "node scripts/make-logo-icons.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "dist": "node scripts/make-logo-icons.cjs && electron-vite build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
